# ─────────────────────────────────────────────────────────────────────────────
# Ledgr — copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=ledgr
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ledgr

# Host "postgres" is the compose service name. Use localhost:5432 when running
# the API on the host against a containerised database.
DATABASE_URL=postgresql://ledgr:change-me-in-production@postgres:5432/ledgr?schema=public

# ── Redis (BullMQ job queue) ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible attachment storage) ────────────────────────────────
MINIO_ROOT_USER=ledgr
MINIO_ROOT_PASSWORD=change-me-in-production
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ledgr-attachments
S3_ACCESS_KEY=ledgr
S3_SECRET_KEY=change-me-in-production
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# These MUST be different from each other. A shared secret means a refresh token
# is accepted as an access token, which silently defeats short access lifetimes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Core API ────────────────────────────────────────────────────────────────
API_PORT=3001
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ── Web ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Browser-reachable API base URL (baked into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Anthropic (receipt/bill extraction) ─────────────────────────────────────
# Get a key at https://console.anthropic.com/. Leave blank to disable the
# extraction stage; OCR still runs and the raw text is stored for manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Sync worker ─────────────────────────────────────────────────────────────
# Fallback poll interval (seconds) for IMAP servers that refuse IDLE.
IMAP_POLL_INTERVAL=300
# Path to the tesseract binary inside the worker container.
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGES=eng

# ── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
