# ─────────────────────────────────────────────────────────────────────────────
# Ledgr — copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=ledgr
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ledgr

# Host "postgres" is the compose service name. Use localhost:5432 when running
# the API on the host against a containerised database.
DATABASE_URL=postgresql://ledgr:change-me-in-production@postgres:5432/ledgr?schema=public

# ── Redis (BullMQ job queue) ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible attachment storage) ────────────────────────────────
MINIO_ROOT_USER=ledgr
MINIO_ROOT_PASSWORD=change-me-in-production
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ledgr-attachments
S3_ACCESS_KEY=ledgr
S3_SECRET_KEY=change-me-in-production
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# These MUST be different from each other. A shared secret means a refresh token
# is accepted as an access token, which silently defeats short access lifetimes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Encryption at rest ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
#
# ⚠️  BACK THIS UP SEPARATELY FROM YOUR DATA BACKUPS.
# Every encrypted column and every backup archive is unreadable without it.
# Losing it means losing your data permanently — there is no recovery path.
# A backup containing both the data and this key is an unencrypted backup.
#
# The API refuses to start if this is unset. That is deliberate: silently
# falling back to plaintext would be worse than failing loudly.
LEDGR_ENCRYPTION_KEY=

# ── Mail providers (all optional) ───────────────────────────────────────────
# A provider with no credentials simply isn't offered on the connect screen.
# IMAP needs none of these — it uses a username and app password per account.
#
# Google:    https://console.cloud.google.com/ → OAuth 2.0 Client ID (Web)
#            Redirect URI: ${PUBLIC_URL}/api/v1/mail/oauth/google/callback
#            ⚠️  PUBLISH the app rather than leaving it in "Testing" status —
#            testing-mode refresh tokens expire after 7 days.
# Microsoft: https://portal.azure.com/ → App registrations
#            Redirect URI: ${PUBLIC_URL}/api/v1/mail/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Externally reachable base URL of the API. Used to build OAuth redirect URIs
# and provider push-notification webhooks; must match what you registered.
PUBLIC_URL=http://localhost:3001

# ── Core API ────────────────────────────────────────────────────────────────
API_PORT=3001
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ── Web ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Browser-reachable API base URL (baked into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Anthropic (receipt/bill extraction) ─────────────────────────────────────
# Get a key at https://console.anthropic.com/. Leave blank to disable the
# extraction stage; OCR still runs and the raw text is stored for manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Sync worker ─────────────────────────────────────────────────────────────
# Fallback poll interval (seconds) for IMAP servers that refuse IDLE.
IMAP_POLL_INTERVAL=300
# Path to the tesseract binary inside the worker container.
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGES=eng

# ── Backup / DR ─────────────────────────────────────────────────────────────
# Off by default so `docker compose up` doesn't silently start writing archives
# before retention has been configured.
BACKUP_ENABLED=false
# Cron expression. Default: 03:15 daily.
BACKUP_SCHEDULE=15 3 * * *
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# age public key that backup archives are encrypted to. Generate a keypair with
# `age-keygen -o backup-key.txt`; put the PUBLIC key here and store the private
# key somewhere you can reach when the server is gone.
BACKUP_ENCRYPTION_RECIPIENT=
# Optional off-site copy. Leave blank for local-only backups.
BACKUP_REMOTE_ENDPOINT=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=

# ── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
