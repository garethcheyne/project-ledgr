    "@nestjs/swagger": "8.1.0",
    "argon2": "0.41.1",
    "helmet": "8.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
