{
  "extends": "@ledgr/config/tsconfig/base",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // The Prisma 7 generator emits .ts source rather than compiled JS, and its
    // internal imports carry explicit .ts extensions.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Generated client code is not ours to police.
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "generated/**/*.ts"],
  "exclude": ["node_modules", "dist", "prisma/seed.ts"]
}
