{
  "name": "ledgr",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, self-hostable personal CRM that tracks relationships, communication, and finances with companies and vendors.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @ledgr/db generate",
    "db:migrate": "pnpm --filter @ledgr/db migrate:dev",
    "db:seed": "pnpm --filter @ledgr/db seed",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@ledgr/config": "workspace:*",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  }
}
